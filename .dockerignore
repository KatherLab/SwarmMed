# Ignore virtual environments
venv/
.venv/
env/

# Ignore database data
postgres_data/
minio_data/

# Ignore user uploads and temporary files
media/
staticfiles/
.gemini/
tmp/

# Ignore git and logs
.git/
*.log
bandit_report_final.json

# Ignore sensitive secrets; the containers get .env via env_file and the
# bind-mounted project directory
.secrets/
.env

# Ignore deployment state (study startup kits and keys, results, local compose
# override); the containers bind-mount the project directory
workspaces/
results/
docker-compose.override.yml

# Ignore node modules
node_modules/

# Ignore Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
