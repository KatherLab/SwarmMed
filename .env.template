# .env.template
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file to version control.

# Django Settings
SECRET_KEY=replace-with-a-secure-random-secret-key
DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.33.107,100.127.11.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:5085,https://localhost:5085,https://100.127.11.1:5085

# Database Settings
POSTGRES_DB=medswarmhub
POSTGRES_USER=medswarmhub
POSTGRES_PASSWORD=replace-with-a-secure-password
DB_ENGINE=django.db.backends.postgresql_psycopg2
DB_HOST=postgres
DB_PORT=5432
DB_NAME=same-as-POSTGRES_DB
DB_USER=same-as-POSTGRES_USER
DB_PASS=same-as-POSTGRES_PASSWORD

# Redis Settings
REDIS_PASSWORD=replace-with-a-secure-password

# MinIO / S3 Settings
MINIO_ROOT_USER=medswarmhub
MINIO_ROOT_PASSWORD=replace-with-a-secure-password
# Format: <key-name>:<32-byte-base64-key>. 
# You can generate a 32-byte base64 key with: python3 -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
MINIO_KMS_SECRET_KEY=replace-with-generated-kms-key
AWS_ACCESS_KEY_ID=medswarmhub
AWS_SECRET_ACCESS_KEY=same-as-MINIO_ROOT_PASSWORD
AWS_STORAGE_BUCKET_NAME=medswarmhub
AWS_S3_ENDPOINT_URL=https://minio:9000
AWS_S3_REGION_NAME=eu-central-1
PUBLIC_URL=https://100.127.11.1:9000

# Privacy Policy Runtime Values
PRIVACY_CONTROLLER_NAME=Your Organization Name
PRIVACY_CONTROLLER_ADDRESS=Your Organization Address
PRIVACY_CONTACT_EMAIL=privacy@example.com
PRIVACY_DPO_EMAIL=same-as-PRIVACY_CONTACT_EMAIL
PRIVACY_DPO_ADDRESS=Your DPO Address
PRIVACY_HOSTING_PROVIDER=Self-hosted
PRIVACY_DATA_REGION=EU
ACCOUNT_ERASURE_GRACE_DAYS=30

# Retention and Anonymization Settings (in days)
BACKUP_RETENTION_DAYS=30
DATA_RETENTION_DAYS=2190
SECURITY_LOG_RETENTION_DAYS=365
IP_ANONYMIZATION_DAYS=90

# Email Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Encryption Keys (Used for data encryption at rest)
# You can generate secure keys using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEYS=replace-with-comma-separated-fernet-keys
# Must be distinct from SECRET_KEY in production
BACKUP_ENCRYPTION_KEY=replace-with-secure-backup-key

# Path to the project on the host machine (required for Docker volumes in sandbox)
HOST_PROJECT_PATH=/path/to/MedSwarmHub

# Docker Host IP (used for binding to host loopback or bridge)
DOCKER_HOST_IP=127.0.0.1

# Custom Hostname (Optional: will be auto-generated if not set)
MEDSWARMHUB_HOSTNAME=replace-with-your-custom-hostname

# Security Settings
# Comma-separated list of allowed file extensions for data upload.
ALLOWED_EXTENSIONS=.csv,.txt,.json,.parquet,.npy,.npz,.h5,.pt,.pth,.dcm,.nii,.nii.gz,.jpg,.jpeg,.png,.bmp,.gif,.pdf
