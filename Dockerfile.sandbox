FROM python:3.10-slim-bookworm

# Set environment variables for non-interactive execution
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1
ENV PATH="/root/.local/bin:${PATH}"

# Install only essential system libraries for numerical computation
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install a set of common data science and machine learning libraries
# These are available to user scripts by default.
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && /root/.local/bin/uv pip install --system --verbose --no-cache-dir \
    "numpy<2.0.0" \
    pandas \
    matplotlib \
    seaborn \
    scikit-learn \
    torch

# Create a non-privileged user to run the scripts
RUN useradd -m sandboxuser
USER sandboxuser

WORKDIR /home/sandboxuser/run

# The actual script and data will be mounted via volumes for security.
ENTRYPOINT ["python"]

